# ScanB Messaging settings. Copy to .env for local use; .env is gitignored.
# Production values belong in the host's configuration / Key Vault, never in a file.

MSG_ENVIRONMENT=development

# ── Identity ──────────────────────────────────────────────────────────────
# Local only: identity comes from an X-Dev-User header. Refused in production.
MSG_DEV_MODE=true
# Real sign-in: the Entra ID app registration that exposes this API.
MSG_AZURE_TENANT_ID=
MSG_AZURE_API_CLIENT_ID=
MSG_AZURE_API_SCOPE_NAME=access_as_user

# ── Storage ───────────────────────────────────────────────────────────────
# memory = nothing persists (local). azure = Blob + Table.
MSG_STORE=memory
# Production: managed identity against the account URLs.
MSG_STORAGE_BLOB_URL=
MSG_STORAGE_TABLE_URL=
# Azurite / local testing only (refused in production).
MSG_STORAGE_CONNECTION_STRING=

# ── Directory (people and permissions, owned by the Web App) ─────────────
# static = dev/directory.dev.json sample people. webapp = the Web App's internal API.
MSG_DIRECTORY=static
MSG_WEBAPP_BASE_URL=https://localhost:7214
MSG_WEBAPP_API_SCOPE=
# Local only: shared key the Web App accepts in Development instead of a token.
MSG_WEBAPP_DEV_KEY=

# ── Verified context ─────────────────────────────────────────────────────
# Base64, 32+ bytes. Must equal the Web App's Messaging:ContextSigningKeys.
# Comma-separate to rotate: the first signs, all verify.
# Generate:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MSG_CONTEXT_SIGNING_KEYS=

# ── Live delivery ────────────────────────────────────────────────────────
# poll = clients poll every 30s. webpubsub = Azure Web PubSub.
MSG_REALTIME=poll
MSG_WEBPUBSUB_ENDPOINT=
MSG_WEBPUBSUB_HUB=scanbmessaging
